# Preferred on Vercel: connect a Blob store to the project. Vercel supplies BLOB_STORE_ID
# and short-lived OIDC authentication automatically. No static Blob token is required.
BLOB_STORE_ID=
# Optional alternative for static server authentication (keep secret)
BLOB_READ_WRITE_TOKEN=

# Gemini 3.5 Flash-Lite API key (keep secret)
GEMINI_API_KEY=
