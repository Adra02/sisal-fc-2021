{
  "_note": "Le fonti YouTube si leggono dai feed RSS pubblici (nessuna YouTube Data API). Se channelId è null lo script lo ricava dall'handle. Controlla gli handle: quelli segnati da_verificare potrebbero non essere esatti.",
  "channels": [
    { "name": "WhiteGamer7", "handle": "@WhiteGamer7", "channelId": null, "enabled": true, "da_verificare": true },
    { "name": "Pro Clubs Weekly", "handle": "@ProClubsWeekly", "channelId": null, "enabled": true, "da_verificare": true },
    { "name": "EA SPORTS FC", "handle": "@EASPORTSFC", "channelId": null, "enabled": true, "da_verificare": true }
  ],
  "filters": {
    "requireAll": ["fc ?27|fc27"],
    "requireAny": ["clubs", "pro clubs", "proclubs", "pro-clubs"],
    "exclude": ["fc ?26 only|fc ?25"],
    "maxAgeDays": 30
  },
  "limits": {
    "maxVideosPerRun": 3,
    "maxEntriesPerVideo": 6,
    "maxKnowledgeEntries": 80,
    "maxProcessedVideos": 200,
    "pauseBetweenCallsMs": 2500
  },
  "gemini": {
    "model": "gemini-3.6-flash",
    "fallbackModels": ["gemini-3.5-flash", "gemini-3.1-flash-lite"]
  }
}
